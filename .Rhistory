list.files()
rm(list=ls())
placement <- read.csv("placement.csv",header=TRUE)
head(placement)
str(placement)
colnames(placement)
summary(placement)
colSums(is.na(placement))
nrow(placement)
table(placement$Placement)
prop.table(table(placement$Placement))*100
mean(placement$CGPA)
mean(placement$IQ)
mean(placement$Communication_Skills)
max(placement$CGPA)
min(placement$CGPA)
# Bar Chart
ggplot(placement, aes(x = Placement)) +
geom_bar(fill = "steelblue") +
labs(
title = "Placement Status",
x = "Placement",
y = "Number of Students"
)
install.packages("ggplot2")
library(ggplot2)
# Bar Chart
ggplot(data = placement, aes(x = Placement)) +
geom_bar(fill = "steelblue") +
labs(
title = "Placement Status",
x = "Placement",
y = "Number of Students"
)
# Average CGPA
ggplot(placement, aes(x = CGPA)) +
geom_histogram(binwidth = 0.5, fill = "green", color = "black") +
labs(
title = "CGPA Distribution",
x = "CGPA",
y = "Number of Students"
)
# -----------------------------
# Graph 6 : Internship Experience
# -----------------------------
ggplot(placement,
aes(x = Internship_Experience,
fill = Internship_Experience)) +
geom_bar() +
labs(
title = "Internship Experience",
x = "Internship Experience",
y = "Number of Students"
)
shinyApp(ui, server)
library(("shiny"))
library(shiny)
runApp()
